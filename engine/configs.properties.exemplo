# ===================================================================
# MODELO DE CONFIGURACAO
#
# Copie para "configs.properties" e preencha com os valores reais.
# O configs.properties e ignorado pelo Git (contem senhas).
#
#     copy engine\configs.properties.exemplo engine\configs.properties
#
# As credenciais do BANCO continuam chegando por argumentos de linha de
# comando, vindas dos .bat (engine\credenciais.bat). Deste arquivo o engine
# le APENAS a secao de FTP. Se o arquivo nao existir, ou se FTP_SERVER estiver
# em branco, os arquivos sao somente gravados em disco e nada e enviado.
# ===================================================================

# ----- BANCO DE DADOS (nao lido pelo engine; mantido para referencia) -----
DB_DRIVER_GSAN = org.postgresql.Driver
DB_URL_GSAN    = jdbc:postgresql://SERVIDOR:5432/BANCO
DB_USER_GSAN   = USUARIO
DB_PASS_GSAN   = SENHA

# ----- FTP -----
FTP_SERVER   = SERVIDOR_FTP
FTP_PORT     = 21
FTP_USER     = USUARIO
FTP_PASS     = SENHA

# Raiz remota. O engine espelha a estrutura da pasta saida abaixo dela, enviando para:
#   FTP_BASE_DIR / <OUTPUT_FOLDER> / [dd_MM_aaaa] / <NOME_DO_COMANDO> / arquivo
#
# No servidor da CAEMA os interessados (CAEMA, PAULO, BI, CAMPANHA...) ficam dentro
# de /results, entao o valor correto e "results" e os arquivos caem em
#   /results/CAEMA/13_07_2026/COMANDO_MADRUGADA/CORTE_CAEMA_..._result_csv.zip
# O subdiretorio de data so aparece quando CREATE_DATE_SUBFOLDER=true no comando.
FTP_BASE_DIR = results

# ----- DESEMPENHO -----
# Memoria de ordenacao por operacao, aplicada apenas na sessao do job (nao altera o servidor).
# Deixe em branco ou remova para usar o padrao do servidor.
WORK_MEM = 2GB
